!tests/fixtures/fibertools_frame/*.bam.bai
*.gtf
*.gff
*.bed

# BLAST databases
*.nin
*.nsq
*.nhr
*.nsi
# ...but not the Windows installer's NSIS scripts
!packaging/windows/*.nsi
*.nsd
*.nog

# Primer output
primers/

# Local editor and agent settings
.claude/

# macOS app bundle and launch scripts
FiberBrowser.app/
Install.command

# Local Copilot artifacts (private until reviewed/distilled into training data)
data/copilot_dataset/usage_logs/
data/copilot_dataset/transitions/
data/copilot_dataset/shared_usage.jsonl
data/copilot_dataset/mlx/
adapters/
fused_models/

# Demo dataset for the guided tour
!browser/data/demo/napa_ddda.bam
!browser/data/demo/napa_ddda.bam.bai
!browser/data/demo/h1_chr1_insertion.bam
!browser/data/demo/h1_chr1_insertion.bam.bai

# Parsed-annotation caches written next to GTF/GFF files
*.fbcache.json

# Copilot training seed set: generated by scripts/build_copilot_dataset.py
