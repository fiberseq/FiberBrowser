data/copilot_dataset/seed_v1.jsonl

# Mac app / wheel build output (packaging/macos/build_app.sh, python -m build)
/build/
/dist/

# Local wheels for a Docker build (deploy/wheels/, see docs/deployment/public-server.md)
deploy/wheels/*.whl

# Local list of private terms for tests/test_repo_hygiene.py
.hygiene-denylist
